# Copy this file to backend/.env and fill in your own credentials.
GEMINI_API_KEY=
YOUCAM_API_KEY=

# Gemini 4 Neon is available on the Gemini API paid tier only.
# If backend/.env already exists, update its GEMINI_MODEL and restart the server.
GEMINI_MODEL=gemini-4-neon
GEMINI_HTTP_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2
GEMINI_CLASSIFY_BATCH_SIZE=4
GEMINI_DIRECT_THRESHOLD=4
