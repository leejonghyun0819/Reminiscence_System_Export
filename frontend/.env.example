# iOS Simulator and web can use localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SHARE_BASE_URL=http://localhost:8081

# For a physical iPhone, copy this file to .env.local and replace the value
# with the Mac's LAN IP. The iPhone and Mac must be on the same Wi-Fi.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000

