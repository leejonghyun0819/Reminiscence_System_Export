# Web and the iOS Simulator can use localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SHARE_BASE_URL=http://localhost:8081

# Android Studio Emulator:
# No .env.local override is required. The app automatically uses 10.0.2.2:8000.

# Physical iPhone or Android phone:
# Copy this file to .env.local and replace the values with the computer's LAN IP.
# The phone and computer must be on the same Wi-Fi.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
# EXPO_PUBLIC_SHARE_BASE_URL=http://192.168.0.10:8081
