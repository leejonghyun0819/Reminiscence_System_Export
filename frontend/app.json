{
    "expo": {
        "name": "Memory-Tracer",
        "slug": "memory-trace",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "memorytrace",
        "userInterfaceStyle": "automatic",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.leejonghyun.memorytrace",
            "buildNumber": "1",
            "infoPlist": {
                "NSLocalNetworkUsageDescription": "Memory-Tracer가 개발 중인 추억 저장 서버에 연결하기 위해 로컬 네트워크를 사용합니다.",
                "NSAppTransportSecurity": {
                    "NSAllowsLocalNetworking": true
                }
            }
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#042252",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": true,
            "package": "com.leejonghyun.memorytrace",
            "versionCode": 1,
            "softwareKeyboardLayoutMode": "resize",
            "blockedPermissions": [
                "android.permission.RECORD_AUDIO"
            ]
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            "./plugins/withAndroidCleartextTraffic",
            [
                "expo-file-system",
                {
                    "supportsOpeningDocumentsInPlace": true,
                    "enableFileSharing": true
                }
            ],
            [
                "expo-image-picker",
                {
                    "photosPermission": "Memory-Tracer가 추억을 만들 사진을 선택할 수 있도록 사진 보관함 접근을 허용해주세요.",
                    "cameraPermission": "Memory-Tracer가 추억으로 남길 사진을 촬영할 수 있도록 카메라 접근을 허용해주세요.",
                    "microphonePermission": false
                }
            ],
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
